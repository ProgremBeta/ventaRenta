//puerto del backend
PORT=

//configuracion de la base de datos en url y local
DATABASE_URL=
DATABASE_LOCAL=

//configuracion de la base de datos en localhost
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

//configuracion de JWT (autenticacion)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7h

//para generar el JWT_SECRET y JWT_REFRESH_SECRET puedes usar el siguiente comando en la terminal:
//pega el codigo generado en el .env, una sola vez y se puede cambiar en cualquier momento.
//node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"